	rm -f tos/*~
	rm -f mgw/*~
	rm -f lnx/*~
	rm -f ../include/*~
	rm -f ../include/mfs/*~
	rm -f ../include/gem/*~
	rm -f ../include/dvx/*~
	rm -f ../include/win/*~
	rm -f ../include/os2/*~
	rm -f ../include/tos/*~
	rm -f ../include/mgw/*~
